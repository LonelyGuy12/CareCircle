#!/bin/sh
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Pattern matching Conventional Commits (e.g. feat: added x, fix: resolved y, feat(auth): added x)
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "\031[31m[ERROR] Invalid commit message format!\033[0m"
    echo "Commit message must follow standard Conventional Commit format:"
    echo "  Example: feat: added authentication system"
    echo "  Example: fix(auth): resolved token expiry bug"
    echo "  Allowed prefixes: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    exit 1
fi
