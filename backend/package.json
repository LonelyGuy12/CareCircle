{
    "name": "backend",
    "version": "1.0.0",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "tsx watch src/main.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "lint:fix": "eslint --fix src/",
        "format": "prettier --write 'src/**/*.ts'",
        "format:check": "prettier --check 'src/**/*.ts'",
        "preinstall": "node ../scripts/check-env.js"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1140.0",
        "@aws-sdk/lib-dynamodb": "^3.1140.0",
        "@upstash/redis": "^1.39.0",
        "argon2": "^0.45.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "jsonwebtoken": "^9.0.3",
        "pino": "^9.14.0",
        "redis": "^4.7.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.19.43",
        "eslint": "^9.39.5",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
}
