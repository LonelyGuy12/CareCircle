{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["node"],
        "noEmit": false,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@infra/*": ["src/infra/*"],
            "@modules/*": ["src/modules/*"],
            "@platform/*": ["src/platform/*"],
            "@shared/*": ["src/shared/*"],
            "@/*": ["src/*"]
        }
    },
    "include": ["src/**/*", "src/generated"],
    "exclude": ["node_modules", "dist"]
}
